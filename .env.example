# Copy this file to .env and replace the password before starting the stack.
# These values are for local development only.
POSTGRES_DB=colegio_connect
POSTGRES_USER=colegio_connect
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

BACKEND_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

